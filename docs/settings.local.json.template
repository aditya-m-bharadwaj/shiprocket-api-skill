{
  "_comment": "Copy this file to .claude/settings.local.json to enforce the deny rules at the harness level. Auto-mode blocks Claude from writing this itself, by design. Paths use `~` so this template works for any user; the harness expands `~` to the operator's home directory.",
  "permissions": {
    "deny": [
      "Bash(security find-generic-password*)",
      "Bash(security add-generic-password*)",
      "Bash(security delete-generic-password*)",
      "Bash(security unlock-keychain*)",
      "Bash(security dump-keychain*)",
      "Bash(security export*)",
      "Bash(secret-tool lookup*)",
      "Bash(secret-tool search*)",
      "Bash(cmdkey /list*)",
      "Bash(cmdkey /generic*)",
      "Bash(echo $SHIPROCKET_TOKEN*)",
      "Bash(echo \"$SHIPROCKET_TOKEN\"*)",
      "Bash(printenv SHIPROCKET_TOKEN*)",
      "Bash(env*SHIPROCKET*)",
      "Bash(printenv*SHIPROCKET*)",
      "Bash(set | grep*SHIPROCKET*)",
      "Bash(curl*apiv2.shiprocket.in*)",
      "Bash(curl*shiprocket.in/v1/external*)",
      "Bash(wget*apiv2.shiprocket.in*)",
      "Bash(http*apiv2.shiprocket.in*)",
      "Bash(httpie*apiv2.shiprocket.in*)",
      "Read(~/.shiprocket-api-skill/token)",
      "Bash(cat ~/.shiprocket-api-skill/token*)",
      "Bash(less ~/.shiprocket-api-skill/token*)",
      "Bash(head ~/.shiprocket-api-skill/token*)",
      "Bash(tail ~/.shiprocket-api-skill/token*)"
    ],
    "allow": [
      "Bash(./bin/shiprocket-api-skill orders*)",
      "Bash(./bin/shiprocket-api-skill order*)",
      "Bash(./bin/shiprocket-api-skill whoami*)",
      "Bash(./bin/shiprocket-api-skill couriers*)",
      "Bash(./bin/shiprocket-api-skill serviceability*)",
      "Bash(./bin/shiprocket-api-skill track*)",
      "Bash(./bin/shiprocket-api-skill pickup-locations*)",
      "Bash(./bin/shiprocket-api-skill classify*)",
      "Bash(./bin/shiprocket-api-skill audit-log*)",
      "Bash(./bin/shiprocket-api-skill gui-setup*)",
      "Bash(./bin/shiprocket-api-skill uninstall-token --yes*)",
      "Bash(shiprocket-api-skill orders*)",
      "Bash(shiprocket-api-skill order*)",
      "Bash(shiprocket-api-skill whoami*)",
      "Bash(shiprocket-api-skill couriers*)",
      "Bash(shiprocket-api-skill serviceability*)",
      "Bash(shiprocket-api-skill track*)",
      "Bash(shiprocket-api-skill pickup-locations*)",
      "Bash(shiprocket-api-skill classify*)",
      "Bash(shiprocket-api-skill audit-log*)",
      "Bash(shiprocket-api-skill gui-setup*)",
      "Bash(shiprocket-api-skill uninstall-token --yes*)",
      "Bash(./bin/shiprocket-api-skill --help*)",
      "Bash(./bin/shiprocket-api-skill *--dry-run*)",
      "Bash(./bin/shiprocket-api-skill *--help*)",
      "Bash(shiprocket-api-skill --help*)",
      "Bash(shiprocket-api-skill *--dry-run*)",
      "Bash(shiprocket-api-skill *--help*)"
    ]
  }
}
