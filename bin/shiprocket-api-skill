#!/usr/bin/env python3
"""shiprocket-api-skill — safe, cross-platform CLI for the Shiprocket API.

AI-AUTHORED: This file was generated by Claude (Anthropic, Claude Opus 4.7).
Read AUTHORS.md for the full disclaimer. Audit the code before trusting it
with a production Shiprocket account.

The credential is loaded at run time from an OS-native secret store when
possible:
  * macOS:  Keychain (via `security`)
  * Linux:  Secret Service (via `secret-tool`) if libsecret is installed
  * Windows / fallback: file at ~/.shiprocket-api-skill/token, mode 0600

The stored secret is a Shiprocket JWT (issued by POST /v1/external/auth/login
with the operator's API-user email + password). The JWT is short-lived
(~10 days). Email and password are entered via a TTY hidden prompt or a
native OS desktop dialog, exchanged for a JWT in memory, then discarded.
Only the JWT is persisted.

Process model:
  - The JWT is held only in this Python process's memory for the duration
    of one CLI call. It never ends up in argv, env vars exported to children,
    log files, or stdout.
  - Every mutating call passes through a safety classifier that requires
    explicit operator-supplied flags. The classifier is defensive: unknown
    mutating endpoints default to the strictest applicable bucket.
  - Every mutation appends one JSON line to ~/.shiprocket-api-skill/audit.log.

Stdlib only — no third-party deps.
"""

from __future__ import annotations

import argparse
import base64
import datetime as dt
import getpass
import json
import os
import pathlib
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from typing import Any, Iterable

VERSION = "0.1.0-alpha.1"
API_BASE = "https://apiv2.shiprocket.in/v1/external"
KEYSTORE_SERVICE = "shiprocket-api-skill"
USER_AGENT = f"shiprocket-api-skill/{VERSION}"

PATH_RE = re.compile(r"^/[A-Za-z0-9/_.{}-]{0,512}$")
EMAIL_RE = re.compile(r"^[^\s@]+@[^\s@]+\.[^\s@]+$")

CONFIG_DIR = pathlib.Path.home() / ".shiprocket-api-skill"
AUDIT_LOG = CONFIG_DIR / "audit.log"
TOKEN_FILE = CONFIG_DIR / "token"


# ---------- Errors ---------------------------------------------------------


class CtlError(Exception):
    """User-facing error. Message is safe to print."""


# ---------- Token store (cross-platform) -----------------------------------


def _platform() -> str:
    p = sys.platform
    if p == "darwin":
        return "macos"
    if p.startswith("linux"):
        return "linux"
    if p in ("win32", "cygwin"):
        return "windows"
    return "unknown"


def _which(cmd: str) -> str | None:
    for d in (os.environ.get("PATH") or "").split(os.pathsep):
        p = pathlib.Path(d) / cmd
        if p.is_file() and os.access(p, os.X_OK):
            return str(p)
        if _platform() == "windows":
            for ext in (".exe", ".cmd", ".bat"):
                p2 = pathlib.Path(d) / (cmd + ext)
                if p2.is_file():
                    return str(p2)
    return None


def _account() -> str:
    return getpass.getuser() or "default"


def _kc_get_macos() -> str | None:
    if _which("security") is None:
        return None
    res = subprocess.run(
        ["security", "find-generic-password", "-s", KEYSTORE_SERVICE, "-a", _account(), "-w"],
        check=False, capture_output=True, text=True,
    )
    if res.returncode != 0:
        return None
    tok = res.stdout.strip()
    return tok or None


def _kc_set_macos(token: str) -> None:
    # `-U` updates in place if the entry exists; this avoids a delete-then-add
    # window where a parallel run sees no token. The token is passed via argv
    # (visible in `ps` to the same user only — same-user attackers already
    # have keychain access).
    res = subprocess.run(
        ["security", "add-generic-password",
         "-s", KEYSTORE_SERVICE, "-a", _account(),
         "-w", token, "-T", "", "-U"],
        check=False, capture_output=True, text=True,
    )
    if res.returncode != 0:
        raise CtlError(f"macOS Keychain store failed: {res.stderr.strip()}")


def _kc_delete_macos() -> None:
    subprocess.run(
        ["security", "delete-generic-password", "-s", KEYSTORE_SERVICE, "-a", _account()],
        check=False, capture_output=True,
    )


def _kc_get_linux() -> str | None:
    if _which("secret-tool") is None:
        return None
    res = subprocess.run(
        ["secret-tool", "lookup", "service", KEYSTORE_SERVICE, "account", _account()],
        check=False, capture_output=True, text=True,
    )
    if res.returncode != 0:
        return None
    tok = res.stdout.strip()
    return tok or None


def _kc_set_linux(token: str) -> None:
    if _which("secret-tool") is None:
        raise CtlError("secret-tool not found. Install libsecret-tools (Debian/Ubuntu) or libsecret (Fedora/Arch).")
    proc = subprocess.run(
        ["secret-tool", "store", "--label", f"{KEYSTORE_SERVICE} API token",
         "service", KEYSTORE_SERVICE, "account", _account()],
        input=token, check=False, capture_output=True, text=True,
    )
    if proc.returncode != 0:
        raise CtlError(f"Linux Secret Service store failed: {proc.stderr.strip()}")


def _kc_delete_linux() -> None:
    if _which("secret-tool") is None:
        return
    subprocess.run(
        ["secret-tool", "clear", "service", KEYSTORE_SERVICE, "account", _account()],
        check=False, capture_output=True,
    )


def _file_get() -> str | None:
    if not TOKEN_FILE.exists():
        return None
    try:
        st = TOKEN_FILE.stat()
        if os.name == "posix" and (st.st_mode & 0o077):
            raise CtlError(
                f"Refusing to read {TOKEN_FILE}: permissions are {oct(st.st_mode & 0o777)}; "
                f"run `chmod 600 {TOKEN_FILE}` and retry."
            )
        with TOKEN_FILE.open("r", encoding="utf-8") as f:
            tok = f.read().strip()
        return tok or None
    except OSError as e:
        raise CtlError(f"Could not read {TOKEN_FILE}: {e}") from None


def _file_set(token: str) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if os.name == "posix":
        os.chmod(CONFIG_DIR, 0o700)
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
    fd = os.open(str(TOKEN_FILE), flags, 0o600)
    try:
        os.write(fd, (token + "\n").encode("utf-8"))
    finally:
        os.close(fd)
    if os.name == "posix":
        os.chmod(TOKEN_FILE, 0o600)
    elif os.name == "nt":
        try:
            user = os.environ.get("USERNAME") or _account()
            subprocess.run(
                ["icacls", str(TOKEN_FILE), "/inheritance:r", "/grant:r", f"{user}:F"],
                check=False, capture_output=True, text=True,
            )
        except FileNotFoundError:
            pass


def _file_delete() -> None:
    if TOKEN_FILE.exists():
        TOKEN_FILE.unlink()


def token_get() -> str | None:
    plat = _platform()
    if plat == "macos":
        t = _kc_get_macos()
        if t:
            return t
    elif plat == "linux":
        t = _kc_get_linux()
        if t:
            return t
    t = _file_get()
    if t:
        return t
    env = os.environ.get("SHIPROCKET_TOKEN", "").strip()
    return env or None


def token_set(token: str, prefer: str | None = None) -> str:
    """Store the JWT. Returns a human description of where it landed."""
    plat = _platform()
    if prefer == "file" or plat == "windows" or plat == "unknown":
        if plat == "macos":
            _kc_delete_macos()
        elif plat == "linux":
            _kc_delete_linux()
        _file_set(token)
        return f"file {TOKEN_FILE} (mode 600)"
    if plat == "macos":
        _kc_set_macos(token)
        _file_delete()
        return f"macOS Keychain (service={KEYSTORE_SERVICE})"
    if plat == "linux":
        if _which("secret-tool"):
            _kc_set_linux(token)
            _file_delete()
            return f"Linux Secret Service (service={KEYSTORE_SERVICE})"
        _file_set(token)
        return (
            f"file {TOKEN_FILE} (mode 600). For stronger storage install libsecret-tools "
            "and re-run setup."
        )
    _file_set(token)
    return f"file {TOKEN_FILE} (mode 600)"


def token_delete() -> list[str]:
    removed = []
    plat = _platform()
    if plat == "macos":
        _kc_delete_macos()
        removed.append("macOS Keychain")
    if plat == "linux":
        _kc_delete_linux()
        removed.append("Linux Secret Service (if present)")
    if TOKEN_FILE.exists():
        _file_delete()
        removed.append(str(TOKEN_FILE))
    return removed


def _load_token() -> str:
    tok = token_get()
    if tok:
        return tok
    raise CtlError(
        "No Shiprocket API token found. Run `shiprocket-api-skill setup` interactively, "
        "or set SHIPROCKET_TOKEN in your shell (never in a file the AI can read)."
    )


# ---------- JWT helpers ----------------------------------------------------
#
# Shiprocket tokens are JWTs with a public-readable payload segment. We decode
# the payload to surface identity/expiry to the operator in `whoami` — purely
# for display. We do NOT trust the payload for authorization; the API server
# is the source of truth. Verifying the token is "live" still requires a real
# read call (see _verify_token_alive).


def _b64url_decode(seg: str) -> bytes:
    pad = "=" * (-len(seg) % 4)
    return base64.urlsafe_b64decode(seg + pad)


def _decode_jwt_payload(token: str) -> dict | None:
    parts = token.split(".")
    if len(parts) != 3:
        return None
    try:
        raw = _b64url_decode(parts[1])
        return json.loads(raw.decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        return None


def _format_exp(payload: dict) -> str:
    exp = payload.get("exp")
    if not isinstance(exp, (int, float)):
        return "(no exp claim)"
    try:
        d = dt.datetime.fromtimestamp(int(exp), dt.timezone.utc)
        return d.isoformat()
    except (OSError, ValueError, OverflowError):
        return f"(invalid exp: {exp!r})"


# ---------- GUI credential dialog (AI-safe credential entry) ----------------
#
# These helpers pop up native desktop dialogs for credential entry. The dialog
# is rendered by the OS WindowServer/compositor — it is not part of any pipe
# or stdout the AI can observe. The user's keystrokes are returned via
# subprocess stdout, which is captured into Python memory and never re-emitted
# by this CLI.
#
# Two-field flow: Shiprocket requires email + password to mint a JWT. We
# prompt for both via the OS dialog, exchange them for a JWT in memory,
# discard the email/password, and persist only the JWT.


def _has_display() -> bool:
    if os.environ.get("SSH_CONNECTION") or os.environ.get("SSH_TTY"):
        return False
    plat = _platform()
    if plat == "linux":
        return bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
    return True


def _no_gui_error() -> CtlError:
    plat = _platform()
    if plat == "linux":
        return CtlError(
            "No GUI credential dialog available.\n"
            "Either:\n"
            "  - Install zenity:  sudo apt install zenity   (Debian/Ubuntu)\n"
            "                     sudo dnf install zenity   (Fedora)\n"
            "                     sudo pacman -S zenity     (Arch)\n"
            "  - Or run `shiprocket-api-skill setup` directly in your terminal."
        )
    if plat == "windows":
        return CtlError(
            "PowerShell not found. Either install PowerShell, or run "
            "`shiprocket-api-skill setup` in your terminal directly."
        )
    return CtlError(
        "Native GUI credential entry is not available on this platform. "
        "Run `shiprocket-api-skill setup` in your terminal directly."
    )


def _osascript_str(s: str) -> str:
    safe = "".join(c for c in s if c == "\n" or c >= " ")
    return safe.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")


def _prompt_credentials_gui() -> tuple[str, str]:
    """Pop a native dialog (or pair of dialogs) and return (email, password).

    Credentials enter this Python process via subprocess.stdout (captured into
    memory, not echoed). They are exchanged for a JWT and discarded; only the
    JWT is persisted.
    """
    if not _has_display():
        raise CtlError(
            "No display server detected (DISPLAY/WAYLAND_DISPLAY unset). "
            "GUI credential entry needs a desktop session. Run "
            "`shiprocket-api-skill setup` directly in the terminal you are using."
        )
    plat = _platform()

    if plat == "macos":
        if _which("osascript") is None:
            raise _no_gui_error()
        email_script = (
            'set t to text returned of (display dialog '
            '"Enter your Shiprocket API-user email.\n\n'
            'The AI assistant cannot see what you type into this dialog." '
            'default answer "" '
            'with title "shiprocket-api-skill — API-user email" '
            'buttons {"Cancel","Next"} default button "Next")\n'
            'return t'
        )
        pw_script = (
            'set t to text returned of (display dialog '
            '"Enter the password for your Shiprocket API user.\n\n'
            'Input is hidden. The AI assistant cannot see what you type." '
            'default answer "" with hidden answer '
            'with title "shiprocket-api-skill — API-user password" '
            'buttons {"Cancel","OK"} default button "OK")\n'
            'return t'
        )
        try:
            p1 = subprocess.run(
                ["osascript", "-e", email_script],
                check=False, capture_output=True, text=True, timeout=300,
            )
        except subprocess.TimeoutExpired:
            raise CtlError("Credential entry timed out (5 minutes).") from None
        if p1.returncode != 0:
            raise CtlError("Credential entry cancelled.")
        email = p1.stdout.strip()
        try:
            p2 = subprocess.run(
                ["osascript", "-e", pw_script],
                check=False, capture_output=True, text=True, timeout=300,
            )
        except subprocess.TimeoutExpired:
            raise CtlError("Credential entry timed out (5 minutes).") from None
        if p2.returncode != 0:
            raise CtlError("Credential entry cancelled.")
        return email, p2.stdout.strip()

    if plat == "linux":
        if _which("zenity"):
            try:
                # `--forms` lets us collect both fields in one dialog.
                proc = subprocess.run(
                    ["zenity", "--forms",
                     "--title=shiprocket-api-skill — API-user credentials",
                     "--text=Enter your Shiprocket API-user email and password (AI cannot read these)",
                     "--add-entry=Email",
                     "--add-password=Password",
                     "--separator=\x1f"],
                    check=False, capture_output=True, text=True, timeout=300,
                )
            except subprocess.TimeoutExpired:
                raise CtlError("Credential entry timed out (5 minutes).") from None
            if proc.returncode != 0:
                raise CtlError("Credential entry cancelled or unavailable.")
            parts = proc.stdout.rstrip("\n").split("\x1f")
            if len(parts) < 2:
                raise CtlError("Credential dialog returned malformed output.")
            return parts[0].strip(), parts[1].strip()
        if _which("kdialog"):
            # kdialog has no two-field form; do two prompts.
            try:
                pe = subprocess.run(
                    ["kdialog", "--title", "shiprocket-api-skill — email",
                     "--inputbox", "Shiprocket API-user email:"],
                    check=False, capture_output=True, text=True, timeout=300,
                )
                if pe.returncode != 0:
                    raise CtlError("Credential entry cancelled.")
                pp = subprocess.run(
                    ["kdialog", "--title", "shiprocket-api-skill — password",
                     "--password", "Shiprocket API-user password (input is hidden):"],
                    check=False, capture_output=True, text=True, timeout=300,
                )
            except subprocess.TimeoutExpired:
                raise CtlError("Credential entry timed out (5 minutes).") from None
            if pp.returncode != 0:
                raise CtlError("Credential entry cancelled.")
            return pe.stdout.strip(), pp.stdout.strip()
        raise _no_gui_error()

    if plat == "windows":
        shell = _which("pwsh") or _which("powershell")
        if not shell:
            raise _no_gui_error()
        # Get-Credential returns one cred object with both fields.
        ps = (
            "$cred = Get-Credential -Message 'Enter your Shiprocket API-user email and password "
            "(AI cannot read these).' ; "
            "if ($null -eq $cred) { exit 1 } ; "
            "Write-Output $cred.UserName ; "
            "Write-Output $cred.GetNetworkCredential().Password"
        )
        try:
            proc = subprocess.run(
                [shell, "-NoProfile", "-Command", ps],
                check=False, capture_output=True, text=True, timeout=300,
            )
        except subprocess.TimeoutExpired:
            raise CtlError("Credential entry timed out (5 minutes).") from None
        if proc.returncode != 0:
            raise CtlError("Credential entry cancelled or unavailable.")
        lines = proc.stdout.replace("\r\n", "\n").splitlines()
        if len(lines) < 2:
            raise CtlError("Credential dialog returned malformed output.")
        return lines[0].strip(), lines[1].strip()

    raise _no_gui_error()


def _confirm_gui(prompt: str) -> bool:
    """Pop a native yes/no dialog. True = user confirmed."""
    if not _has_display():
        return False
    plat = _platform()
    if plat == "macos":
        if _which("osascript") is None:
            return False
        safe = _osascript_str(prompt)
        script = (
            f'set theBtn to button returned of '
            f'(display dialog "{safe}" '
            f'buttons {{"Cancel","Replace"}} default button "Cancel" '
            f'with title "shiprocket-api-skill")\n'
            f'return theBtn'
        )
        proc = subprocess.run(
            ["osascript", "-e", script],
            check=False, capture_output=True, text=True, timeout=120,
        )
        return proc.returncode == 0 and proc.stdout.strip() == "Replace"
    if plat == "linux":
        if _which("zenity"):
            proc = subprocess.run(
                ["zenity", "--question", "--title=shiprocket-api-skill", f"--text={prompt}"],
                check=False, capture_output=True, text=True, timeout=120,
            )
            return proc.returncode == 0
        if _which("kdialog"):
            proc = subprocess.run(
                ["kdialog", "--title", "shiprocket-api-skill", "--yesno", prompt],
                check=False, capture_output=True, text=True, timeout=120,
            )
            return proc.returncode == 0
        return False
    if plat == "windows":
        shell = _which("pwsh") or _which("powershell")
        if not shell:
            return False
        safe = prompt.replace("'", "''")
        ps = (
            "Add-Type -AssemblyName PresentationFramework; "
            f"$ans = [System.Windows.MessageBox]::Show('{safe}', 'shiprocket-api-skill', 'YesNo', 'Question'); "
            "if ($ans -eq 'Yes') { exit 0 } else { exit 1 }"
        )
        proc = subprocess.run(
            [shell, "-NoProfile", "-Command", ps],
            check=False, capture_output=True, text=True, timeout=120,
        )
        return proc.returncode == 0
    return False


# ---------- HTTP -----------------------------------------------------------


def _validate_path(path: str) -> None:
    if not PATH_RE.match(path):
        raise CtlError(f"Refusing to call malformed API path: {path!r}")
    for seg in path.split("/"):
        if seg in ("..", "."):
            raise CtlError(f"Refusing path with traversal segment {seg!r}: {path!r}")


def _request(
    token: str | None,
    method: str,
    path: str,
    *,
    body: Any | None = None,
    query: dict | None = None,
    extra_headers: dict | None = None,
) -> Any:
    _validate_path(path)
    url = f"{API_BASE}{path}"
    if query:
        url += "?" + urllib.parse.urlencode(query)
    data = None
    headers = {
        "User-Agent": USER_AGENT,
        "Accept": "application/json",
    }
    if token is not None:
        headers["Authorization"] = f"Bearer {token}"
    if extra_headers:
        for k, v in extra_headers.items():
            if k.lower() == "authorization":
                continue  # never let callers override auth
            headers[k] = v
    if body is not None:
        if not isinstance(body, (bytes, str)):
            data = json.dumps(body).encode("utf-8")
            headers["Content-Type"] = "application/json"
        elif isinstance(body, str):
            data = body.encode("utf-8")
            headers.setdefault("Content-Type", "application/json")
        else:
            data = body
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            raw = resp.read().decode("utf-8") or ""
            if not raw.strip():
                return {}
            try:
                return json.loads(raw)
            except json.JSONDecodeError:
                return {"_raw": raw[:4000]}
    except urllib.error.HTTPError as e:
        body_text = ""
        try:
            body_text = e.read().decode("utf-8")
            parsed = json.loads(body_text)
            msg = parsed.get("message") or parsed.get("error") or ""
            errs = parsed.get("errors")
            if isinstance(errs, dict):
                msg = "; ".join(f"{k}: {'; '.join(v) if isinstance(v, list) else v}" for k, v in errs.items())
            elif isinstance(errs, list) and errs:
                msg = "; ".join(str(x) for x in errs)
            if msg:
                raise CtlError(f"Shiprocket API {e.code}: {msg}") from None
        except (ValueError, KeyError):
            pass
        raise CtlError(f"Shiprocket API {e.code} {e.reason}: {body_text[:400]}") from None
    except urllib.error.URLError as e:
        raise CtlError(f"Network error calling {url}: {e.reason}") from None


def _paginate(
    token: str,
    path: str,
    query: dict | None = None,
    *,
    extra_headers: dict | None = None,
) -> list[dict]:
    """Paginate Shiprocket list endpoints (data + meta.pagination shape).

    Shiprocket pagination is not uniform across endpoints; this handler covers
    the common envelope (`data` + `meta.pagination` with `current_page` and
    `last_page`). Endpoints with different shapes should be called via the
    generic `api` command with explicit query params.
    """
    out: list[dict] = []
    page = 1
    while True:
        q = dict(query or {})
        q["page"] = page
        q.setdefault("per_page", 50)
        resp = _request(token, "GET", path, query=q, extra_headers=extra_headers)
        chunk = resp.get("data") if isinstance(resp, dict) else None
        if isinstance(chunk, list):
            out.extend(chunk)
        else:
            # Endpoint doesn't use the standard envelope; return what we have.
            break
        meta = (resp.get("meta") or {}).get("pagination") if isinstance(resp, dict) else None
        if not isinstance(meta, dict):
            break
        last = meta.get("last_page") or meta.get("total_pages")
        if not isinstance(last, int) or page >= last:
            break
        page += 1
        if page > 100:
            break
    return out


# ---------- Audit log ------------------------------------------------------


def _audit(action: str, target: str, detail: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if os.name == "posix":
        try:
            os.chmod(CONFIG_DIR, 0o700)
        except OSError:
            pass
    record = {
        "ts": dt.datetime.now(dt.timezone.utc).isoformat(),
        "user": _account(),
        "action": action,
        "target": target,
        "detail": detail,
    }
    line = json.dumps(record, default=str)
    with AUDIT_LOG.open("a", encoding="utf-8") as f:
        f.write(line + "\n")
    if os.name == "posix":
        try:
            os.chmod(AUDIT_LOG, 0o600)
        except OSError:
            pass


# ---------- Safety classification ------------------------------------------
#
# Each Shiprocket API endpoint is classified into one of:
#   read         — GET (and a few quote-style POSTs); no extra confirmation
#   mutating     — generic write; --yes required
#   destructive  — DELETE, cancel, irreversible state changes; --yes + --confirm-id
#   billable     — commits courier capacity or generates paid artifacts;
#                  --yes + --i-understand-billing
#   financial    — moves money / changes payment instruments;
#                  --yes + --allow-financial
#   privilege    — issues credentials, manages users; --yes + --allow-privilege
#
# The matcher normalizes numeric path segments to {id}, strips an optional
# /v1/external prefix, and looks up the most specific entry. Anything not in
# the table falls back to a method default:
#   GET    -> read
#   DELETE -> destructive
#   *      -> mutating
#
# CONSERVATIVE BY DESIGN. Many Shiprocket endpoints use POST for read-like
# operations (e.g. serviceability quotes). Those default to `mutating` —
# stricter than necessary, but the operator can pass --yes to proceed. Better
# this than silently downgrading a billable action to `read`.

_FINANCIAL_PREFIXES = (
    "/wallet/recharge",
    "/payments",
    "/billing",
)

_PRIVILEGE_PREFIXES = (
    "/auth",
    "/users",
    "/sub-users",
    "/settings/api",
    "/api-users",
)

_BILLABLE_EXACT = {
    # Assigning an AWB locks in courier capacity — this is where Shiprocket
    # actually charges the operator. Treat as the financial commit point.
    ("POST", "/courier/assign/awb"),
    ("POST", "/courier/assign/awb/return"),
    # Generating shipping artifacts costs per pull on many plans.
    ("POST", "/courier/generate/pickup"),
    ("POST", "/courier/generate/label"),
    ("POST", "/courier/generate/invoice"),
    ("POST", "/courier/generate/manifest"),
    ("POST", "/manifests/generate"),
    ("POST", "/manifests/print"),
    ("POST", "/orders/print/label"),
    ("POST", "/orders/print/invoice"),
    ("POST", "/orders/print/manifest"),
    # Shipment creation commits a forward / return courier booking.
    ("POST", "/shipments/create/forward-shipment"),
    ("POST", "/shipments/create/return"),
}

_MUTATING_EXACT = {
    # Order creation is free at this step — the billable moment is AWB assign.
    ("POST", "/orders/create/adhoc"),
    ("POST", "/orders/create/return"),
    ("POST", "/orders/import"),
    ("POST", "/orders/update"),
    ("PATCH", "/orders/update"),
    ("POST", "/orders/update/customer"),
    ("POST", "/orders/address/update"),
    # Pickup-location management (free).
    ("POST", "/settings/company/addpickup"),
    ("POST", "/settings/company/pickup/update"),
    # Channel / store management (free).
    ("POST", "/channels"),
    # Product CRUD (free).
    ("POST", "/products"),
    ("PUT", "/products/{id}"),
    ("PATCH", "/products/{id}"),
    # NDR action — instructs the carrier to retry / RTO. Not directly billable
    # but has downstream cost; the runtime SKILL.md tells the AI to confirm.
    ("POST", "/ndr/{id}/action"),
}

_DESTRUCTIVE_EXACT = {
    # Cancellations are irreversible state changes. After AWB assign they can
    # also trigger fees, but the conceptual primary effect is destruction of
    # the booking. The SKILL.md flags the fee risk.
    ("POST", "/orders/cancel"),
    ("POST", "/orders/cancel/shipment/awbs"),
    ("POST", "/shipments/cancel"),
}


def _strip_version(path: str) -> str:
    """Strip the /v1/external prefix if present.

    Shiprocket docs canonically write paths as `/v1/external/orders`, but
    API_BASE already ends in `/v1/external`. Strip the prefix once at the
    boundary so the classifier table can be keyed un-prefixed.
    """
    for prefix in ("/v1/external", "/v1"):
        if path == prefix:
            return "/"
        if path.startswith(prefix + "/"):
            return path[len(prefix):]
    return path


def _normalize_path(path: str) -> str:
    path = _strip_version(path)
    parts = path.split("/")
    norm: list[str] = []
    for p in parts:
        if not p:
            norm.append(p)
            continue
        if p.isdigit():
            norm.append("{id}")
        else:
            norm.append(p)
    return "/".join(norm)


def classify(method: str, path: str) -> tuple[str, list[str], str]:
    """Returns (classification, required_flags, human_explanation)."""
    method = method.upper()
    norm = _normalize_path(path)

    for prefix in _FINANCIAL_PREFIXES:
        if norm.startswith(prefix) and method != "GET":
            return ("financial", ["--yes", "--allow-financial"],
                    f"{method} {norm} touches billing/payments")

    for prefix in _PRIVILEGE_PREFIXES:
        if norm.startswith(prefix) and method != "GET":
            return ("privilege", ["--yes", "--allow-privilege"],
                    f"{method} {norm} can elevate access (auth/users/api-keys)")

    if (method, norm) in _BILLABLE_EXACT:
        return ("billable", ["--yes", "--i-understand-billing"],
                f"{method} {norm} commits courier capacity or generates paid artifacts")

    if (method, norm) in _DESTRUCTIVE_EXACT:
        return ("destructive", ["--yes", "--confirm-id"],
                f"{method} {norm} is an irreversible state change (may incur fees if AWB assigned)")

    if method == "GET":
        return ("read", [], "")

    if method == "DELETE":
        return ("destructive", ["--yes", "--confirm-id"],
                f"{method} {norm} deletes a resource")

    if (method, norm) in _MUTATING_EXACT:
        return ("mutating", ["--yes"], f"{method} {norm} is an in-place change")

    return ("mutating", ["--yes"],
            f"{method} {norm} is an unrecognized mutation; default policy applies")


# ---------- Helpers --------------------------------------------------------


def _emit(obj: Any, json_mode: bool) -> None:
    if json_mode:
        print(json.dumps(obj, indent=2, default=str))
        return
    if isinstance(obj, list):
        if not obj:
            print("(empty)")
            return
        for x in obj:
            print(_format_summary(x))
    elif isinstance(obj, dict):
        print(json.dumps(obj, indent=2, default=str))
    else:
        print(obj)


def _format_summary(x: dict) -> str:
    if not isinstance(x, dict):
        return str(x)
    if "id" in x and "channel_order_id" in x:
        return (
            f"#{x.get('id'):<10} channel={x.get('channel_order_id','?'):<14} "
            f"status={x.get('status','?'):<14} awb={x.get('awb_code','-')} "
            f"courier={x.get('courier_name','-')}"
        )
    if "id" in x and "name" in x:
        return f"#{x.get('id'):<10} {x.get('name','')}"
    return json.dumps(x, default=str)


def _load_body(args: argparse.Namespace) -> Any | None:
    if getattr(args, "data", None) and getattr(args, "body", None):
        raise CtlError("--data and --body are mutually exclusive.")
    if getattr(args, "data", None):
        try:
            return json.loads(args.data)
        except json.JSONDecodeError as e:
            raise CtlError(f"--data is not valid JSON: {e}") from None
    if getattr(args, "body", None):
        p = pathlib.Path(args.body).expanduser()
        if not p.is_file():
            raise CtlError(f"--body file not found: {p}")
        try:
            resolved = p.resolve()
            config_real = CONFIG_DIR.resolve()
            try:
                resolved.relative_to(config_real)
                raise CtlError(
                    f"Refusing --body inside {CONFIG_DIR} — that directory "
                    "holds the API token."
                )
            except ValueError:
                pass
        except OSError:
            pass
        try:
            return json.loads(p.read_text(encoding="utf-8"))
        except json.JSONDecodeError as e:
            raise CtlError(f"--body file {p} is not valid JSON: {e}") from None
    return None


def _parse_query(items: Iterable[str] | None) -> dict | None:
    if not items:
        return None
    out: dict = {}
    for item in items:
        if "=" not in item:
            raise CtlError(f"--query expects k=v pairs; got {item!r}")
        k, v = item.split("=", 1)
        out[k] = v
    return out


def _login(email: str, password: str) -> str:
    """Exchange email+password for a Shiprocket JWT.

    Hits POST /v1/external/auth/login. The email and password are passed in
    the body and never written to argv, env, or disk. The returned JWT is
    what gets persisted; the email/password are dropped from memory by the
    caller after this returns.
    """
    if not EMAIL_RE.match(email):
        raise CtlError("Email looks malformed.")
    if not password:
        raise CtlError("Password cannot be empty.")
    resp = _request(
        None, "POST", "/auth/login",
        body={"email": email, "password": password},
    )
    token = None
    if isinstance(resp, dict):
        token = resp.get("token") or resp.get("access_token")
    if not token or not isinstance(token, str):
        raise CtlError("Login response did not contain a token. Verify the API user credentials in the Shiprocket dashboard.")
    return token.strip()


def _verify_token_alive(token: str) -> dict:
    """Hit a low-impact read endpoint to confirm the token is server-side valid.

    Returns the parsed response so callers can surface metadata. Shiprocket
    has no `/me` endpoint, so we list one order page; the response shape
    confirms authorization without side effects.
    """
    return _request(token, "GET", "/orders", query={"page": 1, "per_page": 1})


# ---------- Named commands -------------------------------------------------


def _describe_identity(token: str) -> str:
    payload = _decode_jwt_payload(token)
    if not payload:
        return "(JWT payload not decodable)"
    parts = []
    name = " ".join(x for x in (payload.get("first_name"), payload.get("last_name")) if x)
    if name:
        parts.append(name)
    if payload.get("email"):
        parts.append(payload["email"])
    if payload.get("id"):
        parts.append(f"id={payload['id']}")
    if payload.get("company_id"):
        parts.append(f"company_id={payload['company_id']}")
    parts.append(f"token_exp={_format_exp(payload)}")
    return " — ".join(parts) if parts else "(no identity claims in JWT)"


def cmd_setup(args: argparse.Namespace) -> int:
    if not sys.stdin.isatty():
        raise CtlError(
            "setup must run in an interactive terminal (cannot read credentials from a non-TTY).\n"
            "If you're piping output, run `shiprocket-api-skill setup` directly in your shell instead."
        )
    print(f"shiprocket-api-skill {VERSION} setup — platform={_platform()}")
    print()

    existing = token_get()
    if existing:
        try:
            _verify_token_alive(existing)
            print(f"An existing token is stored: {_describe_identity(existing)}")
        except CtlError:
            print("An existing token is stored, but it failed to authenticate "
                  "(possibly expired or revoked).")
        if not args.replace:
            ans = input("Replace it with a new token? [y/N] ").strip().lower()
            if ans not in ("y", "yes"):
                print("Aborted; existing token left in place.")
                return 0

    print()
    print("Enter your Shiprocket API-user credentials.")
    print("Create an API user at: https://app.shiprocket.in/api-user")
    print("The CLI exchanges them for a 10-day JWT and stores only the JWT.")
    print()
    email = input("API-user email: ").strip()
    if not email:
        raise CtlError("Empty email; aborting.")
    password = getpass.getpass("Password (hidden): ")
    if not password:
        raise CtlError("Empty password; aborting.")

    print("Logging in to /v1/external/auth/login ...")
    token = _login(email, password)
    # email / password go out of scope here; only the JWT is persisted.
    del password
    print("Verifying with /v1/external/orders ...")
    _verify_token_alive(token)
    where = token_set(token, prefer=("file" if args.file else None))
    print(f"Token stored in: {where}")
    print(f"Authenticated as: {_describe_identity(token)}")
    if existing:
        print("Old token replaced. The previous JWT remains valid on Shiprocket's "
              "side until it expires; rotate your API-user password if it leaked.")
    return 0


def cmd_gui_setup(args: argparse.Namespace) -> int:
    """Add or rotate the API token via a native desktop dialog.

    Designed to be invoked by an AI agent. Email and password are entered into
    an OS-rendered dialog that the AI cannot observe. They are exchanged for a
    JWT in this process's memory and immediately discarded; only the JWT is
    persisted. Only success/failure metadata is printed to stdout.
    """
    print(f"shiprocket-api-skill {VERSION} gui-setup — platform={_platform()}")
    print("A credential dialog will appear on your desktop. The AI cannot read what you type into it.")
    print("If you don't see the dialog, look for it on another desktop or behind other windows.")
    print()

    existing = token_get()
    if existing:
        try:
            _verify_token_alive(existing)
            who_label = _describe_identity(existing)
            print(f"An existing token is stored: {who_label}")
        except CtlError:
            who_label = "(failed to authenticate — possibly expired)"
            print("An existing token is stored, but it failed to authenticate.")
        if not args.replace:
            ok = _confirm_gui(f"Replace the existing Shiprocket token?\nCurrent: {who_label}")
            if not ok:
                print("Aborted; existing token left in place.")
                return 0

    print("Waiting for credential entry in the desktop dialog...")
    email, password = _prompt_credentials_gui()
    if not email or not password:
        raise CtlError("Empty credentials; aborting.")
    print("Logging in to /v1/external/auth/login ...")
    token = _login(email, password)
    del password
    print("Verifying with /v1/external/orders ...")
    _verify_token_alive(token)
    where = token_set(token, prefer=("file" if args.file else None))
    print(f"Token stored in: {where}")
    print(f"Authenticated as: {_describe_identity(token)}")
    if existing:
        print("Old token replaced. The previous JWT remains valid on Shiprocket's "
              "side until it expires; rotate the API-user password if it leaked.")
    return 0


def cmd_uninstall_token(args: argparse.Namespace) -> int:
    if not args.yes:
        raise CtlError("Refusing to delete stored token without --yes.")
    removed = token_delete()
    if not removed:
        print("No stored token to remove.")
    else:
        for r in removed:
            print(f"Removed token from: {r}")
    return 0


def cmd_whoami(args: argparse.Namespace) -> int:
    token = _load_token()
    # Always go to the server too — JWT payload alone doesn't prove the token
    # hasn't been revoked.
    _verify_token_alive(token)
    payload = _decode_jwt_payload(token) or {}
    safe = {
        "first_name": payload.get("first_name"),
        "last_name": payload.get("last_name"),
        "email": payload.get("email"),
        "id": payload.get("id"),
        "company_id": payload.get("company_id"),
        "token_exp": _format_exp(payload),
    }
    _emit(safe, args.json)
    return 0


def cmd_orders(args: argparse.Namespace) -> int:
    token = _load_token()
    query: dict[str, Any] = {"per_page": args.limit}
    if args.status:
        query["filter_by"] = "status"
        query["filter"] = args.status
    resp = _request(token, "GET", "/orders", query=query)
    if args.json:
        print(json.dumps(resp, indent=2, default=str))
        return 0
    data = resp.get("data") if isinstance(resp, dict) else None
    if not isinstance(data, list):
        print(json.dumps(resp, indent=2, default=str))
        return 0
    _emit(data, False)
    return 0


def cmd_order_status(args: argparse.Namespace) -> int:
    token = _load_token()
    resp = _request(token, "GET", "/orders/show", query={"order_id": args.order_id})
    _emit(resp, args.json)
    return 0


def cmd_couriers(args: argparse.Namespace) -> int:
    token = _load_token()
    resp = _request(token, "GET", "/courier/courierListWithCounryCode")
    if args.json:
        print(json.dumps(resp, indent=2, default=str))
        return 0
    data = resp.get("courier_data") if isinstance(resp, dict) else resp
    if isinstance(data, list):
        for c in data:
            print(f"#{c.get('id','?'):<6} {c.get('name','?')}")
        return 0
    print(json.dumps(resp, indent=2, default=str))
    return 0


def cmd_serviceability(args: argparse.Namespace) -> int:
    token = _load_token()
    q = {
        "pickup_postcode": args.pickup_pin,
        "delivery_postcode": args.delivery_pin,
        "weight": args.weight,
        "cod": 1 if args.cod else 0,
    }
    if args.declared_value is not None:
        q["declared_value"] = args.declared_value
    resp = _request(token, "GET", "/courier/serviceability", query=q)
    _emit(resp, args.json)
    return 0


def cmd_track(args: argparse.Namespace) -> int:
    token = _load_token()
    if args.awb:
        resp = _request(token, "GET", f"/courier/track/awb/{args.awb}")
    elif args.order_id:
        resp = _request(token, "GET", "/courier/track", query={"order_id": args.order_id})
    else:
        raise CtlError("Pass either --awb <awb-code> or --order-id <id>.")
    _emit(resp, args.json)
    return 0


def cmd_pickup_locations(args: argparse.Namespace) -> int:
    token = _load_token()
    resp = _request(token, "GET", "/settings/company/pickup")
    _emit(resp, args.json)
    return 0


def cmd_audit_log(args: argparse.Namespace) -> int:
    if not AUDIT_LOG.exists():
        print("(audit log empty)")
        return 0
    with AUDIT_LOG.open("r", encoding="utf-8") as f:
        lines = f.readlines()
    if args.last:
        lines = lines[-args.last:]
    for line in lines:
        print(line.rstrip())
    return 0


def cmd_classify(args: argparse.Namespace) -> int:
    cls, flags, why = classify(args.method, args.path)
    out = {
        "method": args.method.upper(),
        "path": args.path,
        "normalized": _normalize_path(args.path),
        "classification": cls,
        "required_flags": flags,
        "explanation": why,
    }
    _emit(out, args.json)
    return 0


# ---------- Generic API command --------------------------------------------


def cmd_api(args: argparse.Namespace) -> int:
    method = args.method.upper()
    if method not in {"GET", "POST", "PUT", "DELETE", "PATCH"}:
        raise CtlError(f"Unsupported HTTP method: {method!r}")
    _validate_path(args.path)
    api_path = _strip_version(args.path)

    cls, required, why = classify(method, args.path)
    missing = []
    if "--yes" in required and not args.yes:
        missing.append("--yes")
    if "--confirm-id" in required:
        if not args.confirm_id:
            missing.append("--confirm-id")
        else:
            last = args.path.rstrip("/").split("/")[-1]
            # For POSTs to /orders/cancel etc. the "id" the operator confirms
            # is meaningful only when the path actually ends in one. When it
            # doesn't, require the confirm-id to match the body's order_id /
            # awb / shipment_id field.
            body_preview = _load_body(args) if (args.data or args.body) else None
            if isinstance(body_preview, dict):
                candidates = [
                    str(body_preview.get(k))
                    for k in ("order_id", "awb", "awbs", "shipment_id", "id")
                    if body_preview.get(k) is not None
                ]
                if isinstance(body_preview.get("ids"), list):
                    candidates.extend(str(x) for x in body_preview["ids"])
                if isinstance(body_preview.get("awbs"), list):
                    candidates.extend(str(x) for x in body_preview["awbs"])
                if args.confirm_id not in candidates and args.confirm_id != last:
                    raise CtlError(
                        f"--confirm-id mismatch: must equal the path's last segment "
                        f"({last!r}) or one of the body's id/awb fields {candidates}."
                    )
            else:
                if args.confirm_id != last:
                    raise CtlError(
                        f"--confirm-id mismatch: path ends with {last!r} but --confirm-id was {args.confirm_id!r}."
                    )
    if "--i-understand-billing" in required and not args.i_understand_billing:
        missing.append("--i-understand-billing")
    if "--allow-financial" in required and not args.allow_financial:
        missing.append("--allow-financial")
    if "--allow-privilege" in required and not args.allow_privilege:
        missing.append("--allow-privilege")
    if missing:
        raise CtlError(
            f"Refusing {method} {args.path}: classification={cls}; missing flags: {' '.join(missing)}.\n"
            f"  reason: {why}\n"
            f"  required: {' '.join(required)}\n"
            f"  see `shiprocket-api-skill classify {method} '{args.path}'` for details."
        )

    body = _load_body(args)
    query = _parse_query(args.query)

    if args.dry_run:
        _emit({
            "method": method,
            "path": args.path,
            "classification": cls,
            "would_send_body": body,
            "query": query,
        }, args.json)
        return 0

    token = _load_token()

    if args.paginate and method == "GET":
        result = _paginate(token, api_path, query=query)
    else:
        result = _request(token, method, api_path, body=body, query=query)

    if cls != "read":
        _audit(
            f"api:{method.lower()}",
            args.path,
            {"classification": cls, "body_keys": list(body.keys()) if isinstance(body, dict) else None},
        )

    if args.json or method != "GET":
        print(json.dumps(result, indent=2, default=str))
    else:
        if isinstance(result, dict) and "data" in result and isinstance(result["data"], list):
            _emit(result["data"], False)
        else:
            _emit(result, False)
    return 0


# ---------- Argparse -------------------------------------------------------


def _add_mut(p: argparse.ArgumentParser) -> None:
    p.add_argument("--yes", action="store_true", help="Confirm intent (required for mutations).")
    p.add_argument("--dry-run", action="store_true", help="Print what would be sent; do not call API.")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="shiprocket-api-skill",
        description=f"shiprocket-api-skill {VERSION} — safe CLI for the Shiprocket API.",
        epilog="Run `shiprocket-api-skill <subcmd> --help` for per-command flags.",
    )
    p.add_argument("--json", action="store_true", help="Emit JSON output where applicable.")
    p.add_argument("--version", action="version",
                   version=f"shiprocket-api-skill {VERSION} (AI-authored by Claude — see AUTHORS.md)")
    sub = p.add_subparsers(dest="cmd", required=True)

    # ---- meta
    p_setup = sub.add_parser(
        "setup",
        help="Add or replace the API token (terminal, interactive). Requires a TTY — AI agents cannot run this.",
    )
    p_setup.add_argument("--file", action="store_true",
                         help="Force file storage even if a system keystore is available.")
    p_setup.add_argument("--replace", action="store_true",
                         help="Skip the 'replace existing token?' prompt.")
    p_setup.set_defaults(func=cmd_setup)

    p_gui = sub.add_parser(
        "gui-setup",
        help="Add or replace the API token via a native desktop dialog. AI-runnable: AI never sees credentials.",
    )
    p_gui.add_argument("--file", action="store_true")
    p_gui.add_argument("--replace", action="store_true")
    p_gui.set_defaults(func=cmd_gui_setup)

    p_rot = sub.add_parser(
        "rotate-token",
        help="Alias for `setup` (terminal). For AI-driven rotation use `gui-setup`.",
    )
    p_rot.add_argument("--file", action="store_true")
    p_rot.add_argument("--replace", action="store_true")
    p_rot.set_defaults(func=cmd_setup)

    p_un = sub.add_parser("uninstall-token", help="Remove the stored API token.")
    p_un.add_argument("--yes", action="store_true")
    p_un.set_defaults(func=cmd_uninstall_token)

    sub.add_parser("whoami", help="Show authenticated identity (no token printed).").set_defaults(func=cmd_whoami)

    p_cls = sub.add_parser("classify", help="Show how a method+path would be classified.")
    p_cls.add_argument("method")
    p_cls.add_argument("path")
    p_cls.set_defaults(func=cmd_classify)

    # ---- discovery / read
    p_orders = sub.add_parser("orders", help="List orders.")
    p_orders.add_argument("--status", help="Filter by status (e.g. NEW, READY_TO_SHIP, CANCELED).")
    p_orders.add_argument("--limit", type=int, default=25)
    p_orders.set_defaults(func=cmd_orders)

    p_os = sub.add_parser("order", help="Show one order by id.")
    p_os.add_argument("order_id")
    p_os.set_defaults(func=cmd_order_status)

    sub.add_parser("couriers", help="List available couriers.").set_defaults(func=cmd_couriers)

    p_serv = sub.add_parser("serviceability",
                             help="Quote courier serviceability for a pickup/delivery pair.")
    p_serv.add_argument("--pickup-pin", required=True)
    p_serv.add_argument("--delivery-pin", required=True)
    p_serv.add_argument("--weight", required=True, help="Package weight in kg.")
    p_serv.add_argument("--cod", action="store_true", help="Cash-on-delivery.")
    p_serv.add_argument("--declared-value", type=float)
    p_serv.set_defaults(func=cmd_serviceability)

    p_track = sub.add_parser("track", help="Track a shipment by AWB or order id.")
    p_track.add_argument("--awb")
    p_track.add_argument("--order-id")
    p_track.set_defaults(func=cmd_track)

    sub.add_parser("pickup-locations",
                   help="List configured pickup locations.").set_defaults(func=cmd_pickup_locations)

    # ---- audit
    p_aud = sub.add_parser("audit-log", help="Print local audit log of mutations.")
    p_aud.add_argument("--last", type=int)
    p_aud.set_defaults(func=cmd_audit_log)

    # ---- generic api
    p_api = sub.add_parser(
        "api",
        help="Generic API call: shiprocket-api-skill api <METHOD> <path> [flags]. "
             "Safety classifier enforces required flags.",
    )
    p_api.add_argument("method", help="GET, POST, PUT, DELETE, PATCH")
    p_api.add_argument("path", help="Path under /v1/external, e.g. /orders or /v1/external/orders")
    p_api.add_argument("--query", action="append", help="k=v query string param. Repeatable.")
    grp = p_api.add_mutually_exclusive_group()
    grp.add_argument("--data", help="Inline JSON body string.")
    grp.add_argument("--body", help="Path to a JSON file to send as body.")
    p_api.add_argument("--paginate", action="store_true",
                       help="For GET only: auto-paginate all pages.")
    p_api.add_argument("--yes", action="store_true")
    p_api.add_argument("--confirm-id",
                       help="For destructive ops: must equal the path's last segment "
                            "or one of the body's id/awb fields.")
    p_api.add_argument("--i-understand-billing", action="store_true")
    p_api.add_argument("--allow-financial", action="store_true")
    p_api.add_argument("--allow-privilege", action="store_true")
    p_api.add_argument("--dry-run", action="store_true")
    p_api.set_defaults(func=cmd_api)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except CtlError as e:
        print(f"error: {e}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        print("interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
